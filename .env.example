# =============================================================================
# .env.example — Conducar Agent (variables de entorno)
# Copia este archivo a `.env` y completa los valores. `.env` NO se versiona
# (está en .gitignore). NO pongas secretos reales aquí.
#
# ⚠️ PRODUCCIÓN (fail-fast): con NODE_ENV=production la app NO arranca si
#    ADMIN_TOKEN o PANEL_PASSWORD faltan, están vacíos o usan estos placeholders
#    (valores débiles). Además, docker compose (local y PROD) aborta con error
#    claro si POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB no están definidos.
#
# Organización:
#   (A) REQUERIDAS SIEMPRE ............ necesarias para arrancar en cualquier modo
#   (B) CHATWOOT_ENABLED=true .......... obligatorias solo si activas Chatwoot
#   (C) LEGACY / ROLLBACK Meta ......... backend WhatsApp actual (NO eliminar)
#   (D) DOCKER COMPOSE ................. POSTGRES_* (obligatorias para compose)
#                                         + APP_PORT (opcional). Valores SOLO-DEV.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# (A) REQUERIDAS SIEMPRE
# ─────────────────────────────────────────────────────────────────────────────

# Puerto interno del agente. Dentro del contenedor Docker el compose lo fija a
# 3000 (ver docker-compose.yml); en ejecución local sin Docker úsalo tal cual.
PORT=3000
# SOLO LOCAL/desarrollo: `development` permite arrancar con los placeholders de
# ADMIN_TOKEN/PANEL_PASSWORD de este archivo.
# ⚠️ EN PRODUCCIÓN (VPS): DEBE ser `production` para activar el fail-fast de
#    secretos (con production + placeholders la app NO arranca, a propósito).
NODE_ENV=development

# URL pública del agente (para construir URLs de imágenes/flyers).
# Dentro de la red Docker de Compose: http://app:3000 (nombre de servicio).
# En producción con dominio: https://tu-dominio.pe
BASE_URL=http://app:3000

# Conexión a PostgreSQL. Dentro de Docker el compose SOBREESCRIBE esta variable
# con la URL interna por servicio (`postgres:5432`). Local sin Docker: apunta a
# tu Postgres local.
DATABASE_URL=postgresql://conducar:conducar@localhost:5432/conducar?schema=public

# OpenAI (motor del agente)
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# Panel del operador.
# ⚠️ PRODUCCIÓN: ADMIN_TOKEN y PANEL_PASSWORD son OBLIGATORIOS y deben ser
#    fuertes. Los placeholders de abajo hacen que la app ABORTE el arranque con
#    NODE_ENV=production (no arrancarás con valores débiles).
ADMIN_TOKEN=cambia-por-un-token-largo-aleatorio
PANEL_USERNAME=admin
PANEL_PASSWORD=cambia-por-una-password-larga-aleatoria

# Negocio
TIMEZONE=America/Lima
CURRENCY=S/
BUSINESS_NAME=Conducar
# Horas de anticipación mínima para reservar (0 = sin mínimo)
MIN_ADVANCE_HOURS=0

# QR de pago (imagen estática en public/, se comparte al reservar) — opcional.
# En Docker (misma red compose) usa http://app:3000/QRConducar.jpeg
QR_IMAGE_URL=http://app:3000/QRConducar.jpeg

# Ruta local del webhook de Meta que monta este servidor
WEBHOOK_PATH=/webhook/meta

# ─────────────────────────────────────────────────────────────────────────────
# (C) LEGACY / ROLLBACK — WhatsApp Cloud API (Meta)
# NO ELIMINAR: env.ts las exige al arranque (required()) aunque el flujo activo
# sea Chatwoot. Son el backend actual y el rollback limpio.
# Obtén estas credenciales en https://developers.facebook.com/
# Sección: WhatsApp > Configuration > API Setup
# ─────────────────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=tu-access-token-de-meta
# ID del número de teléfono asociado a tu cuenta de WhatsApp Business
META_PHONE_NUMBER_ID=000000000000000
# Secreto de la app de Meta (firma HMAC-SHA256 del webhook)
META_APP_SECRET=tu-app-secret
# Token de verificación del webhook (lo defines tú al configurar el webhook en Meta)
META_VERIFY_TOKEN=conducar-ia-2026
# Versión de la Graph API de Meta (opcional, default: v21.0)
# META_API_VERSION=v21.0

# ─────────────────────────────────────────────────────────────────────────────
# (B) CHATWOOT — REQUERIDAS SOLO CON CHATWOOT_ENABLED=true
# Controla si el agente responde por Chatwoot (true) o sigue con el backend Meta
# actual (false/default = rollback limpio). Se requiere además configurar el
# webhook en el panel de Chatwoot apuntando a {BASE_URL}{CHATWOOT_WEBHOOK_PATH}.
# Con enabled=true, fail-fast: URL válida, IDs > 0 y tokens no vacíos, o no arranca.
# ─────────────────────────────────────────────────────────────────────────────
CHATWOOT_ENABLED=false
# URL base de tu instalación de Chatwoot (ej. https://chatwoot.tudominio.com)
CHATWOOT_BASE_URL=
# IDs de cuenta e inbox de Chatwoot (panel: Settings > General)
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
# Token de acceso a la API (Settings > API > Access Token) — NO lo publiques
CHATWOOT_API_TOKEN=
# Secreto del webhook (Settings > Integrations > Webhooks). Firma HMAC-SHA256.
CHATWOOT_WEBHOOK_SECRET=
# Ruta local donde se monta el webhook (default: /webhooks/chatwoot)
# CHATWOOT_WEBHOOK_PATH=/webhooks/chatwoot
# ---------------------------------------------------------------------------
# CHATWOOT_BOT_SENDER_ID
#   QUÉ REPRESENTA: el id del usuario (agente "user") o AgentBot en Chatwoot
#   cuyas credenciales usa Conducar para ENVIAR mensajes a WhatsApp. Es el
#   `sender.id` que aparecerá en los message_created de sus propias respuestas.
#   PUEDES VERLO en: Settings > Agents (id del agente) o en la vista Detalles de
#   una conversación → Mensaje del bot → su id de emisor.
#   CUÁNDO CONFIGURARLO: idealmente SIEMPRE. Es OBLIGATORIO cuando el token de
#   API usado corresponde a un usuario tipo "user": en ese caso los mensajes de
#   salida del bot llegan al webhook con sender.type="user", y sin este id no se
#   distinguirían de los mensajes de un agente humano.
#   IMPORTANTE: la detección por sender.type NO es suficiente para identificar
#   al propio bot (los mensajes del bot también salen como sender.type="user").
#   El guard anti-self-mute se apoya en message_type/private ANTES que en este
#   id; el id es un backstop adicional.
# Déjalo comentado (o vacío) si Conducar envía con un AgentBot: los mensajes
# entrantes del bot igualmente se ignoran por message_type/private.
# CHATWOOT_BOT_SENDER_ID=
# ---------------------------------------------------------------------------
# ID del agente de Chatwoot para asignar conversaciones en handoff (opcional).
# Si no se configura, el handoff solo silencia el bot sin asignar en Chatwoot.
# Obtener el ID desde Chatwoot: Settings → Agents → copiar el ID del agente.
# CHATWOOT_ASSIGNEE_ID=
# ---------------------------------------------------------------------------
# Timeout (ms) y reintentos para llamadas a la API de Chatwoot (opcional)
# CHATWOOT_TIMEOUT_MS=15000
# CHATWOOT_MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────────────────────
# (D) DOCKER COMPOSE — OBLIGATORIAS para docker compose (local y prod)
# El compose aborta con error si no existen (${VAR:?}).
# ─────────────────────────────────────────────────────────────────────────────
# Puerto HOST (loopback) donde se publica el agente (panel, webhook).
# Default: 3001 (si en el servidor ya hay otro servicio en el 3000).
APP_PORT=3001
#
# Credenciales de la BD usadas por el compose para postgres y para construir la
# DATABASE_URL interna. POSTGRES_PASSWORD debe ser URL-safe (alfanumérico).
#
# ⚠️ VALORES DE ABAJO SON SOLO-DEV (mínimos, sin valor real): NUNCA los uses en
#    producción. En el VPS usa contraseñas largas generadas aleatoriamente.
#
# ⚠️ SI TU BD LOCAL YA EXISTE (volumen docker con credenciales previas, p.ej.
#    las antiguas `conducar/conducar`): mantén en estos POSTGRES_* LOS MISMOS
#    valores de arranque de esa BD, o resetea la BD local con
#    `docker compose down -v` y deja que se cree de nuevo con los nuevos valores
#    (se pierden los datos locales del volumen).
POSTGRES_USER=conducar
POSTGRES_PASSWORD=conducar-dev-local
POSTGRES_DB=conducar

# ── Feature Flags Fase 2B (Conversational Router) ──────────────
# Habilitar el router stateful (default: false)
# USE_STATEFUL_ROUTER=false

# Teléfonos para canary testing (comma-separated, E.164)
# Si está vacío y USE_STATEFUL_ROUTER=true → TODOS los mensajes usan el router
# CANARY_PHONES=

# IDs de conversación para canary testing (comma-separated)
# CANARY_CONVERSATION_IDS=

# Expiración del estado conversacional en minutos (default: 30)
# STATE_EXPIRY_MINUTES=30