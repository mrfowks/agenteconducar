# ===== Servidor / Agente =====
# Dentro de Docker Compose se sobreescribe con PORT=3000 (ver docker-compose.yml)
PORT=3000
NODE_ENV=production
# Puerto host donde se publica el agente (panel, webhook, imágenes).
# Si en el servidor hay otro servicio en el 3000 (ej. panel de Easypanel), usa 3001.
APP_PORT=3001

# ===== URL pública del agente =====
# Se usa para construir URLs de imágenes (flyers de paquetes). Dentro de la red
# Docker de Compose, los contenedores se alcanzan por su nombre de servicio.
# En producción con dominio: https://tu-dominio.pe
BASE_URL=http://app:3000

# ===== OpenAI (ChatGPT) =====
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# ===== Base de datos PostgreSQL =====
DATABASE_URL=postgresql://conducar:conducar@localhost:5432/conducar?schema=public

# ===== Evolution API =====
# Dentro de Docker Compose se sobreescribe con http://evolution-api:8080
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-global-apikey
EVOLUTION_INSTANCE=conducar

# ===== Panel del operador =====
ADMIN_TOKEN=cambia-este-token
PANEL_USERNAME=admin
PANEL_PASSWORD=conducar2026

# ===== QR de pago (se comparte al reservar) =====
# Coloca la imagen en la carpeta public/ (ej. public/QRConducar.jpeg) y apunta la URL aquí.
# En Docker (misma red compose) usa http://app:3000/QRConducar.jpeg
QR_IMAGE_URL=http://app:3000/QRConducar.jpeg
# ===== Negocio =====
# Zona horaria usada para calcular disponibilidad
TIMEZONE=America/Lima
# Moneda mostrada en respuestas
CURRENCY=S/
# Nombre del negocio
BUSINESS_NAME=Conducar
# Horas de anticipación mínima para reservar (0 = sin mínimo)
MIN_ADVANCE_HOURS=0

# ===== Webhook de Evolution API (este servidor) =====
WEBHOOK_PATH=/webhook/evolution
